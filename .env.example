# VCG Forum MCP environment variables

# Optional: Enable write access from the environment instead of the --write flag.
# Values: "1" to enable, anything else to disable (default: disabled)
# WARNING: Do NOT put your actual Discourse API key here. The key is stored locally
# in ~/.config/vcg-forum-mcp/profile.json after login; it is NOT read from .env.
VCG_FORUM_MCP_ALLOW_WRITES=0
